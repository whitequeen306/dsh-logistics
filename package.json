{
  "name": "dsh-logistics",
  "version": "0.6.2",
  "description": "Project logistics for DeepSeek Harness — whole-project review reports from five specialist subagents, with one core report and stable finding IDs.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./skills/*": "./skills/*"
  },
  "files": [
    "lib",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "ARCHITECTURE.md",
    "MODULE-DECISION.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check lib/index.js && node --test test/*.test.js"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "code-review",
    "security",
    "testing",
    "cleanup",
    "reports",
    "modules",
    "subagents"
  ],
  "license": "MIT",
  "author": "whitequeen306",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whitequeen306/dsh-logistics.git"
  },
  "homepage": "https://github.com/whitequeen306/dsh-logistics#readme",
  "bugs": {
    "url": "https://github.com/whitequeen306/dsh-logistics/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
